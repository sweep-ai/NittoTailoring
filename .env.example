VITE_TYPEFORM_LIVE_ID=01KTNBNYDMJSH7PKS373QG2AJF
VITE_SITE_NAME=Alpha Reset System
# men | women — controls which testimonial banner and videos are shown
VITE_AUDIENCE=men
VITE_CONTACT_EMAIL=
# Production URL for sitemap.xml (e.g. https://booking.yourdomain.com)
VITE_SITE_URL=

# --- Sweep OS funnel analytics (see FUNNEL_STEPS.md) ---
VITE_FUNNEL_ID=ee46f8a6-ace5-4dd1-9279-abf58ae6ae9c

# Production API (used in builds + Vercel)
VITE_API_BASE_URL=https://api.sweepai.site

# Local dev: proxy browser requests to the API above (avoids CORS)
# npm run dev sends /sweep-api/* → VITE_API_PROXY_TARGET automatically
VITE_API_PROXY_TARGET=https://api.sweepai.site
VITE_FUNNEL_TRACK_DEBUG=true

# Local dev against a local Sweep API instead:
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: set to false to silence tracking while developing UI
# VITE_FUNNEL_TRACKING_ENABLED=false
